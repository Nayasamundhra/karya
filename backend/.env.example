# ---------------------------------------------------------------------------
# Karya backend - example environment file
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   PowerShell : Copy-Item .env.example .env
#   bash       : cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_NAME=Karya
ENVIRONMENT=local
DEBUG=false

# --- PostgreSQL -------------------------------------------------------------
# These are consumed BOTH by docker-compose (to provision the container) and by
# the application (to build the SQLAlchemy connection URL).
POSTGRES_DB=karya
POSTGRES_USER=karya
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
# Retargets BOTH the published container port and the application, so the two
# can never drift. Use 5433 if a native PostgreSQL already owns 5432.
POSTGRES_PORT=5432

# --- Optional explicit connection URL --------------------------------------
# When set, DATABASE_URL wins over the POSTGRES_* values above. Useful for
# managed databases / CI. Must use the psycopg (v3) driver.
# DATABASE_URL=postgresql+psycopg://karya:change-me-locally@localhost:5432/karya

# --- Test database ----------------------------------------------------------
# Defaults to "<POSTGRES_DB>_test" on the same server when unset. The test
# suite creates this database automatically if it does not exist.
# TEST_DATABASE_URL=postgresql+psycopg://karya:change-me-locally@localhost:5432/karya_test

# --- Authentication (Phase 2) ----------------------------------------------
# REQUIRED for authentication. There is deliberately no default: the app
# refuses to start when ENVIRONMENT is anything other than local/test and this
# is unset, and refuses to mint or accept any token when it is missing.
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-value-min-32-chars

# HMAC algorithm used to sign access tokens.
JWT_ALGORITHM=HS256

# Access tokens are short-lived JWTs; refresh tokens are opaque and revocable.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS -------------------------------------------------------------------
# Comma-separated list of EXACT origins. A wildcard is rejected at startup:
# Karya sends credentials, for which "*" is both invalid per the CORS spec and
# unsafe. Leave empty to allow no browser origin at all (safe default for a
# backend-only deployment).
CORS_ALLOWED_ORIGINS=http://localhost:5173
