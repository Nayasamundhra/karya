# ---------------------------------------------------------------------------
# Karya backend - example environment file
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   PowerShell : Copy-Item .env.example .env
#   bash       : cp .env.example .env
#
# Every value below is a DEVELOPMENT default. Production requirements are in
# docs/PRODUCTION.md, and several of these values are rejected outright when
# ENVIRONMENT=production - see "Production fail-fast" at the end of this file.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_NAME=Karya

# One of: local | test | staging | production. A closed set: an unrecognised
# value (`prod`, `Production`, a trailing space) fails at startup rather than
# silently behaving like development.
ENVIRONMENT=local

# Must be false in production; startup refuses otherwise.
DEBUG=false

# Serve /docs, /redoc and /openapi.json. Safe to leave on - every route they
# document is independently authenticated - but set false if you would rather
# not publish the shape of the API.
DOCS_ENABLED=true

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
# json  -> one object per line, for a log shipper (the default)
# console -> human-readable single line, for a terminal
LOG_FORMAT=json

# --- PostgreSQL -------------------------------------------------------------
# These are consumed BOTH by docker-compose (to provision the container) and by
# the application (to build the SQLAlchemy connection URL).
POSTGRES_DB=karya
POSTGRES_USER=karya
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
# Retargets BOTH the published container port and the application, so the two
# can never drift. Use 5433 if a native PostgreSQL already owns 5432.
POSTGRES_PORT=5432

# --- Optional explicit connection URL --------------------------------------
# When set, DATABASE_URL wins over the POSTGRES_* values above. Useful for
# managed databases / CI. Must use the psycopg (v3) driver.
# DATABASE_URL=postgresql+psycopg://karya:change-me-locally@localhost:5432/karya

# --- Test database ----------------------------------------------------------
# Defaults to "<POSTGRES_DB>_test" on the same server when unset. The test
# suite creates this database automatically if it does not exist.
# TEST_DATABASE_URL=postgresql+psycopg://karya:change-me-locally@localhost:5432/karya_test

# --- Connection pool --------------------------------------------------------
# Each API process holds up to (POOL_SIZE + MAX_OVERFLOW) server connections.
# PostgreSQL's max_connections is a shared budget:
#   instances x workers x (POOL_SIZE + MAX_OVERFLOW) < max_connections - headroom
# A bigger pool does not make a saturated database faster; it moves the queue
# out of the app, where it is bounded and visible, into the server.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
# Retire connections before an idle proxy or managed-database timeout does.
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
# Server-side ceilings, in milliseconds. 0 disables either one.
# statement_timeout bounds a runaway query; lock_timeout bounds the FOR UPDATE
# waits the attendance and last-admin paths rely on. Both stop one wedged
# transaction from holding a pool slot until the pool is exhausted.
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000

# --- Authentication ---------------------------------------------------------
# REQUIRED for authentication. There is deliberately no default: the app
# refuses to start when ENVIRONMENT is anything other than local/test and this
# is unset, and refuses to mint or accept any token when it is missing.
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-value-min-32-chars

# HMAC algorithm used to sign access tokens.
JWT_ALGORITHM=HS256

# Access tokens are short-lived JWTs; refresh tokens are opaque and revocable.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS -------------------------------------------------------------------
# Comma-separated list of EXACT origins. A wildcard is rejected at startup:
# Karya sends credentials, for which "*" is both invalid per the CORS spec and
# unsafe. Leave empty to allow no browser origin at all (safe default for a
# backend-only deployment). In production every origin must use https://.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- HTTP hardening ---------------------------------------------------------
# Largest accepted request body and query string, in bytes. Karya's biggest
# payload is a presence verification of a few hundred bytes, so these are
# generous while still refusing a multi-megabyte body before it is parsed.
MAX_REQUEST_BODY_BYTES=65536
MAX_QUERY_STRING_BYTES=2048

# Strict-Transport-Security. Unset means "on in production, off elsewhere":
# HSTS on localhost pins the whole browser profile to a scheme that host cannot
# serve. Only meaningful over HTTPS.
# HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000

# --- Rate limiting ----------------------------------------------------------
# In-memory and therefore PER PROCESS: real protection against one client
# hammering one instance, but NOT a shared limit across instances, and lost on
# restart. See docs/PRODUCTION.md before relying on it at the edge.
RATE_LIMIT_ENABLED=true

# Per client address, per minute.
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_REFRESH_PER_MINUTE=60

# Failed logins per (tenant, email) per 15 minutes. Counts only failures, and a
# success clears the counter - so mistyping a password twice is invisible while
# a guessing script is not.
RATE_LIMIT_LOGIN_FAILURES_PER_15_MIN=10

# Per authenticated user. Set well above real use: someone checks in twice a
# day, and the office QR display refreshes about twice a minute.
RATE_LIMIT_PASSWORD_CHANGE_PER_15_MIN=5
RATE_LIMIT_QR_CHALLENGE_PER_MINUTE=60
RATE_LIMIT_PRESENCE_PER_MINUTE=30
RATE_LIMIT_ATTENDANCE_PER_MINUTE=20
RATE_LIMIT_ADMIN_WRITE_PER_MINUTE=120

# Upper bound on distinct keys tracked, so a flood of unique client addresses
# cannot grow the process's memory without limit.
RATE_LIMIT_MAX_TRACKED_KEYS=100000

# --- Presence verification --------------------------------------------------
# Worst device-reported GPS accuracy still accepted, in metres. A phone that
# only knows it is "somewhere within 500 m" cannot evidence presence inside a
# 150 m geofence, so such a reading is rejected rather than trusted.
MAX_GPS_ACCURACY_METERS=100

# Lifetime of a dynamic QR challenge, in seconds. Short by design: the office
# display rotates the code, so a photographed QR is useless within seconds.
# The server sets expires_at = now() + this; the client cannot choose it.
QR_CHALLENGE_TTL_SECONDS=30

# --- Outbound email (Phase 11: onboarding) ---------------------------------
# Left unset, sending degrades to a structured log line instead of failing -
# a fresh checkout and the test suite need no mail server or API key. Two
# transports; if both are set, Brevo's API wins (see
# app/services/email/mailer.py for the full reasoning) - filling either in
# only affects the app you run yourself, `pytest`'s own `hermetic_smtp`
# fixture (tests/conftest.py) always forces both back to unconfigured for
# every test, so the suite never emails a real address.
#
# Brevo's HTTP API - plain HTTPS, not SMTP, so it works on hosts that block
# outbound SMTP connections as an anti-spam-relay measure (confirmed on
# Render's free tier: a real SMTP send attempt hung until timeout and never
# reached smtp-relay.brevo.com at all - this is the transport this project
# actually deploys with). Get the key from Brevo -> SMTP & API -> API Keys.
# BREVO_API_KEY=xkeysib-...
BREVO_API_TIMEOUT_SECONDS=10
#
# SMTP - for a provider/host where outbound SMTP isn't blocked (Gmail app
# password, SendGrid SMTP relay, your own mailbox, ...).
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@karya.local
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# --- Onboarding (Phase 11) ---------------------------------------------------
# Where the emailed verification link points - the frontend's own origin,
# not this API's. Has no security meaning of its own (the token in the link
# is what actually authorizes anything) - purely "where to send a human".
PUBLIC_APP_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_HOURS=24
# Per-IP: the one public, unauthenticated *write* endpoint in the whole API.
RATE_LIMIT_ONBOARDING_PER_HOUR=5
RATE_LIMIT_EMAIL_VERIFICATION_PER_HOUR=20

# ---------------------------------------------------------------------------
# Production fail-fast
#
# With ENVIRONMENT=production the application refuses to start if:
#   - JWT_SECRET_KEY is missing, shorter than 32 characters, or still one of the
#     placeholder values published in this file
#   - DEBUG is true
#   - POSTGRES_PASSWORD is empty or a placeholder (unless DATABASE_URL is set)
#   - any CORS_ALLOWED_ORIGINS entry is not https://
#   - LOG_LEVEL is not a real level, or any limit/timeout/pool value is invalid
#   - neither SMTP_HOST nor BREVO_API_KEY is set (with no transport
#     configured, the onboarding verification link is logged instead of
#     emailed - fine locally, not in production)
#   - PUBLIC_APP_URL is not https:// (it's emailed straight into that same
#     verification link)
#
# The geofence radius is NOT configured here: it lives per tenant on
# attendance_locations.geofence_radius_meters, so each site sets its own.
# ---------------------------------------------------------------------------
