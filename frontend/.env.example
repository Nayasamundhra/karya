# Karya frontend — environment configuration
#
# Copy to `.env.local` for local development (Vite loads `.env.local` over
# `.env`, and `.env.local` is gitignored). Every variable consumed by the app
# MUST be prefixed `VITE_` — Vite only exposes prefixed variables to client
# code, and only prefixed variables are validated by src/config/env.ts.
#
# IMPORTANT — anything in a VITE_ variable ends up in the built JS bundle,
# readable by anyone who opens the app. Never put a secret here: no JWT
# signing key, no database credential, no server-side API key. Karya's
# frontend has no legitimate use for any of those anyway — it only ever holds
# a short-lived access token and a refresh token issued to it by the backend
# at runtime, never a value baked in at build time.

# Base URL of the Karya backend API (no trailing slash). In local development
# this is the FastAPI server started with `uvicorn app.main:app --reload`
# from backend/.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Build-time metadata, surfaced in error/support UI and logged on startup.
# Not read from the backend — the frontend and backend are versioned and
# deployed independently.
VITE_APP_ENV=development
